# Copy this file to .env and fill in real values before running docker compose.
# .env is git-ignored; never commit actual credentials.

# OpenSearch admin password — must satisfy the OpenSearch complexity policy
# (min 8 chars, upper, lower, digit, special character).
OPENSEARCH_PASSWORD=change-me-before-use

# Quarkus application secrets (set in your shell, not in .env for production)
# export OPENSEARCH_USERNAME=admin
# export OPENAI_API_KEY=sk-...
# export MEMORY_CONTAINER_ID=<your-container-id>
